<?xml version="1.0" ?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<!--
  Maryland UrbanEV — calibrated baseline (100% population), 50 iterations.

  Parameter set: C0 baseline (ratified 2026-06-18 by composite-L calibration
  across 23 sensitivity cells; tied with B3 on data, picked for literature
  defensibility). See analysis/calibration_rank.py and output/sensitivity/
  calibration_ranking.csv for selection rationale.

  Inputs (full scale):
    - 99,132 EV agents (plans_maryland_ev_clean_anx020.xml.gz)
    - 1,744 MD chargers (chargers.xml — 1391 L2, 274 DCFC, 77 DCFC_TESLA, 2 L1)
    - 57 vehicle archetypes (urbanev_vehicletypes.xml)

  Calibrated parameters (all C0 defaults):
    parkingSearchRadius=500m, betaMoney=-1.0, alphaScaleCost=1.0,
    publicChargingCost=$0.40/kWh, homeChargingCost=$0.139/kWh,
    workChargingCost=$0.00/kWh, awarenessFactor=0.3,
    defaultRangeAnxietyThreshold=0.2

  Iterations: 50  (innovation on iter 0-39, frozen scoring iter 40-49)

  Wall: ~15-25h on Ryzen 7 2700X / 64 GB (single 100% run; no 2-wide).
  Output: output/baseline_calibrated_100pct/

  Run from UrbanEV-Maryland/ root (after sourcing ../tools/env.sh):
    java -Xmx32g [add-opens flags from analysis/sensitivity_runner.py ADD_OPENS]
         -jar target/UrbanEV-Maryland-1.0-jar-with-dependencies.jar
         scenarios/maryland/config_baseline_calibrated_100pct.xml
-->
<config>

    <module name="ev">
        <param name="auxDischargeTimeStep" value="10"/>
        <param name="chargeTimeStep" value="5"/>
        <param name="chargersFile" value="../../../Input/chargers/chargers.xml"/>
        <param name="timeProfiles" value="true"/>
        <param name="vehiclesFile" value="../../../Input/vehicles/electric_vehicles.xml"/>
    </module>

    <module name="urban_ev">
        <param name="parkingSearchRadius" value="500"/>
        <param name="defaultRangeAnxietyThreshold" value="0.2"/>
        <param name="vehicleTypesFile" value="../../../Input/vehicles/urbanev_vehicletypes.xml"/>
        <param name="rangeAnxietyUtility" value="-6"/>
        <param name="emptyBatteryUtility" value="-15"/>
        <param name="walkingUtility" value="-1"/>
        <param name="homeChargingUtility" value="0"/>
        <param name="socDifferenceUtility" value="-4"/>
        <param name="maxNumberSimultaneousPlanChanges" value="2"/>
        <param name="timeAdjustmentProbability" value="0.2"/>
        <param name="maxTimeFlexibility" value="600"/>
        <param name="generateHomeChargersByPercentage" value="false"/>
        <param name="homeChargerPercentage" value="80"/>
        <param name="defaultHomeChargerPower" value="11"/>
        <param name="generateWorkChargersByPercentage" value="false"/>
        <param name="workChargerPercentage" value="20"/>
        <param name="defaultWorkChargerPower" value="11"/>

        <!-- Calibrated MD pricing (C0 winner; Phase 4 sources) -->
        <param name="homeChargingCost" value="0.139"/>
        <param name="workChargingCost" value="0.0"/>
        <param name="publicChargingCost" value="0.40"/>
        <!-- Option B: realistic per-type public EVSE baseline (matches policy design reference) -->
        <param name="publicL2Cost" value="1.27"/>
        <param name="publicDcfcCost" value="1.43"/>
        <param name="publicDcfcTeslaCost" value="1.4"/>
        <param name="betaMoney" value="-1.0"/>
        <param name="alphaScaleCost" value="1.0"/>
        <param name="enableSmartCharging" value="true"/>
        <param name="alphaScaleTemporal" value="0.5"/>
        <param name="awarenessFactor" value="0.3"/>
        <param name="coincidenceFactor" value="0.7"/>
    </module>

    <module name="global">
        <param name="randomSeed" value="4711" />
        <param name="coordinateSystem" value="EPSG:26985" />
        <param name="numberOfThreads" value="15"/>
    </module>

    <module name="network">
        <param name="inputNetworkFile" value="../../../Input/network/maryland-network-pt2matsim.xml.gz"/>
        <param name="timeVariantNetwork" value="false" />
        <param name="inputChangeEventsFile" value="null" />
    </module>

    <module name="plans">
        <!-- warm-start from the converged flat-$0.40 100% baseline; re-equilibrate charging under per-type prices -->
        <param name="inputPlansFile" value="output/runs_2026/baseline_pertype/output_plans.xml.gz"/>
    </module>

    <module name="transit">
        <param name="useTransit" value="false" />
    </module>

    <module name="controler">
        <param name="outputDirectory" value="output/runs_2026/sweep_pub_100c" />
        <param name="overwriteFiles" value="deleteDirectoryIfExists" />
        <param name="firstIteration" value="0"/>
        <param name="lastIteration" value="8"/>
        <param name="eventsFileFormat" value="xml"/>
        <param name="mobsim" value="qsim"/>
        <param name="writeEventsInterval" value="25"/>
        <param name="writePlansInterval" value="25"/>
        <param name="routingAlgorithmType" value="FastAStarLandmarks" />
        <param name="createGraphs" value="true"/>
        <param name="writeTripsInterval" value="25"/>
    </module>

    <module name="qsim">
        <param name="startTime" value="00:00:00"/>
        <param name="endTime" value="168:00:00"/>
        <param name="flowCapacityFactor" value="1.0" />
        <param name="storageCapacityFactor" value="1.0" />
        <param name="snapshotperiod" value="01:00:00"/>
        <param name="numberOfThreads" value="15"/>
    </module>

    <module name="planCalcScore">
        <param name="learningRate" value="0.5"/>
        <param name="BrainExpBeta" value="2.0"/>
        <param name="writeExperiencedPlans" value="false"/>
        <param name="usingOldScoringBelowZeroUtilityDuration" value="false"/>

        <parameterset type="scoringParameters">
            <param name="subpopulation" value="null"/>
            <param name="marginalUtilityOfMoney" value="1.0"/>
            <param name="performing" value="6.0"/>
            <param name="lateArrival" value="-18.0"/>
            <param name="earlyDeparture" value="0.0"/>
            <param name="waiting" value="0.0"/>
            <param name="waitingPt" value="-6.0"/>
            <param name="utilityOfLineSwitch" value="-1.0"/>

            <parameterset type="modeParams">
                <param name="mode" value="car"/>
                <param name="constant" value="0.0"/>
                <param name="marginalUtilityOfDistance_util_m" value="0.0"/>
                <param name="marginalUtilityOfTraveling_util_hr" value="-6.0"/>
                <param name="monetaryDistanceRate" value="-0.00002"/>
            </parameterset>

            <parameterset type="modeParams">
                <param name="mode" value="pt"/>
                <param name="constant" value="0.0"/>
                <param name="marginalUtilityOfDistance_util_m" value="0.0"/>
                <param name="marginalUtilityOfTraveling_util_hr" value="-6.0"/>
                <param name="monetaryDistanceRate" value="0.0"/>
            </parameterset>

            <parameterset type="modeParams">
                <param name="mode" value="walk"/>
                <param name="constant" value="0.0"/>
                <param name="marginalUtilityOfDistance_util_m" value="0.0"/>
                <param name="marginalUtilityOfTraveling_util_hr" value="-6.0"/>
                <param name="monetaryDistanceRate" value="0.0"/>
            </parameterset>

            <parameterset type="modeParams">
                <param name="mode" value="bike"/>
                <param name="constant" value="0.0"/>
                <param name="marginalUtilityOfDistance_util_m" value="0.0"/>
                <param name="marginalUtilityOfTraveling_util_hr" value="-6.0"/>
                <param name="monetaryDistanceRate" value="0.0"/>
            </parameterset>

            <parameterset type="activityParams">
                <param name="activityType" value="home"/>
                <param name="priority" value="1.0"/>
                <param name="typicalDuration" value="12:00:00"/>
                <param name="typicalDurationScoreComputation" value="relative"/>
            </parameterset>

            <parameterset type="activityParams">
                <param name="activityType" value="work"/>
                <param name="priority" value="1.0"/>
                <param name="typicalDuration" value="08:00:00"/>
                <param name="typicalDurationScoreComputation" value="relative"/>
            </parameterset>

            <parameterset type="activityParams">
                <param name="activityType" value="school"/>
                <param name="priority" value="1.0"/>
                <param name="typicalDuration" value="07:00:00"/>
                <param name="typicalDurationScoreComputation" value="relative"/>
            </parameterset>

            <parameterset type="activityParams">
                <param name="activityType" value="other"/>
                <param name="priority" value="1.0"/>
                <param name="typicalDuration" value="03:00:00"/>
                <param name="typicalDurationScoreComputation" value="relative"/>
            </parameterset>

            <parameterset type="activityParams">
                <param name="activityType" value="car interaction"/>
                <param name="scoringThisActivityAtAll" value="false"/>
                <param name="typicalDuration" value="00:00:01"/>
                <param name="typicalDurationScoreComputation" value="relative"/>
            </parameterset>

            <parameterset type="activityParams">
                <param name="activityType" value="pt interaction"/>
                <param name="scoringThisActivityAtAll" value="false"/>
                <param name="typicalDuration" value="00:00:01"/>
                <param name="typicalDurationScoreComputation" value="relative"/>
            </parameterset>

            <parameterset type="activityParams">
                <param name="activityType" value="home charging"/>
                <param name="scoringThisActivityAtAll" value="false"/>
                <param name="typicalDuration" value="00:00:01"/>
            </parameterset>

            <parameterset type="activityParams">
                <param name="activityType" value="work charging"/>
                <param name="scoringThisActivityAtAll" value="false"/>
                <param name="typicalDuration" value="00:00:01"/>
            </parameterset>

            <parameterset type="activityParams">
                <param name="activityType" value="school charging"/>
                <param name="scoringThisActivityAtAll" value="false"/>
                <param name="typicalDuration" value="00:00:01"/>
            </parameterset>

            <parameterset type="activityParams">
                <param name="activityType" value="other charging"/>
                <param name="scoringThisActivityAtAll" value="false"/>
                <param name="typicalDuration" value="00:00:01"/>
            </parameterset>

            <parameterset type="activityParams">
                <param name="activityType" value="home charging failed"/>
                <param name="scoringThisActivityAtAll" value="false"/>
                <param name="typicalDuration" value="00:00:01"/>
            </parameterset>

            <parameterset type="activityParams">
                <param name="activityType" value="work charging failed"/>
                <param name="scoringThisActivityAtAll" value="false"/>
                <param name="typicalDuration" value="00:00:01"/>
            </parameterset>

            <parameterset type="activityParams">
                <param name="activityType" value="school charging failed"/>
                <param name="scoringThisActivityAtAll" value="false"/>
                <param name="typicalDuration" value="00:00:01"/>
            </parameterset>

            <parameterset type="activityParams">
                <param name="activityType" value="other charging failed"/>
                <param name="scoringThisActivityAtAll" value="false"/>
                <param name="typicalDuration" value="00:00:01"/>
            </parameterset>
        </parameterset>
    </module>

    <module name="strategy">
        <!-- 50 iter; innovation on for 80% (iter 0-39), frozen iter 40-49 -->
        <param name="fractionOfIterationsToDisableInnovation" value="0.8" />
        <param name="maxAgentPlanMemorySize" value="5" />
        <parameterset type="strategysettings">
            <param name="strategyName" value="SelectExpBeta"/>
            <param name="weight" value="0.7"/>
            <param name="subpopulation" value="nonCriticalSOC"/>
        </parameterset>
        <parameterset type="strategysettings">
            <param name="strategyName" value="ChangeChargingBehaviour"/>
            <param name="weight" value="0.3"/>
            <param name="subpopulation" value="nonCriticalSOC"/>
        </parameterset>
        <parameterset type="strategysettings">
            <param name="strategyName" value="SelectExpBeta"/>
            <param name="weight" value="0"/>
            <param name="subpopulation" value="criticalSOC"/>
        </parameterset>
        <parameterset type="strategysettings">
            <param name="strategyName" value="ChangeChargingBehaviour"/>
            <param name="weight" value="1"/>
            <param name="subpopulation" value="criticalSOC"/>
        </parameterset>
    </module>
</config>
